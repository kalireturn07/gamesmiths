{
  "name": "gamesmiths-site",
  "private": true,
  "version": "1.0.0",
  "description": "Website for Gamesmiths — the BEC Digital Arts Club at Basaveshwar Engineering College, Bagalkot.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
